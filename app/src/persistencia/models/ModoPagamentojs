const { Model, DataTypes, QueryTypes } = require("sequelize");
const SequelizeConnection = require("../SequelizeConnection.js");

const sequelize = SequelizeConnection.getConnection().instance;

/**
 * Gerenciador integracao keycloak.
 * @class
 */
class ModoPagamento extends Model {}

ModoPagamento.init(
  {
    id: {
      allowNull: false,
      autoIncrement: true,
      primaryKey: true,
      type: DataTypes.INTEGER
    },
    descricao: {
      type: DataTypes.TEXT,
      allowNull: false,
    },
  },
  {
    sequelize,
    modelName: "ModoPagamento",
    tableName: "modo_pagamento",
    createdAt: "created_at",
    updatedAt: "updated_at"
  }
);

async function createPagamentoFactura(descricao) {
  return ModoPagamento.create({
    "descricao": descricao
  });
}

async function getModoPagamentos() {
  return ModoPagamento.findAll()
}


module.exports = {
  createPagamentoFactura,
  getModoPagamentos
};
